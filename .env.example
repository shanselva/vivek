# Use a MongoDB account scoped to readWrite on the application database.
MONGODB_URI=mongodb://app-user:replace-me@127.0.0.1:27017/construction?authSource=admin

# Generate at least 32 random characters. Never reuse this placeholder.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional. When omitted, supported images are stored under public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
